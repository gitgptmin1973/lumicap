{
  "manifest_version": 3,
  "name": "LUMICAP Full Page Capture",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "現在のページを表示領域またはページ全体でキャプチャし、LUMICAP Studioへ連携します。",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "LUMICAPでキャプチャ",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "capture-viewport": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "表示領域をキャプチャ"
    },
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+5",
        "mac": "Command+Shift+5"
      },
      "description": "ページ全体をキャプチャ"
    }
  }
}
